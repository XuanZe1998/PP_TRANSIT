# Frontend runtime/build configuration. Copy to config/.env.local.
VITE_API_BASE_URL=http://127.0.0.1:8089
VITE_API_PROXY_TARGET=http://127.0.0.1:8089
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
VITE_ALLOWED_HOSTS=linknux.com,api.linknux.com

# High-risk external ShopGPT checkout is disabled unless explicitly enabled.
VITE_ENABLE_SHOPGPT=false

# Optional browser inactivity timeout. Values below five minutes are ignored.
VITE_AUTH_IDLE_TIMEOUT_MS=1800000

# OAuth provider credentials. Redirect URIs must match provider consoles exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://linknux.com/oauth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://linknux.com/oauth/callback/google
