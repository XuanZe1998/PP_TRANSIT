# ========== 代理配置 ==========
PROXY=http://127.0.0.1:7897

# ========== Flask服务配置 ==========
# 仅监听本机，由 Spring Boot 管理员代理统一鉴权。
HOST=127.0.0.1
PORT=5000
DEBUG=false

# ========== MySQL配置 ==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=gpt_payment

# ========== 默认支付地区 ==========
DEFAULT_COUNTRY=US
DEFAULT_CURRENCY=USD

# Must match payment-service.internal-token in the Spring Boot configuration.
PAYMENT_SERVICE_INTERNAL_TOKEN=<LONG_RANDOM_INTERNAL_TOKEN>
